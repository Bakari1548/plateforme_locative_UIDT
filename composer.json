{
    "name": "croust/plateforme-locative",
    "description": "Plateforme de gestion de l'occupation du site VCN - CROUS-T",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "backend/app/",
            "App\\Config\\": "backend/config/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "start": "php -S localhost:8000 -t backend/public",
        "migrate": "php backend/database/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
